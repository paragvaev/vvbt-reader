{
  "name": "vvbt-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "cloudflare:dev": "npm run build && wrangler pages dev",
    "cloudflare:deploy": "npm run build && wrangler pages deploy",
    "cloudflare:db:local": "wrangler d1 migrations apply vvbt-reader --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply vvbt-reader --remote"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "wrangler": "^4.119.0"
  }
}
